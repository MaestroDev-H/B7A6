# Server
PORT=5000
NODE_ENV=development
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/housing_platform?schema=public"

# JWT
JWT_ACCESS_SECRET=super-secret-access-key-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-change-me
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Redis (optional - caching, rate limiting)
REDIS_URL=redis://localhost:6379

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Housing Platform <no-reply@housing.com>"

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
CLIENT_SUCCESS_URL=http://localhost:5000/api/v1/payments/success
CLIENT_CANCEL_URL=http://localhost:5000/api/v1/payments/cancel

# Google Social Login (GCP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Admin seed credentials
ADMIN_EMAIL=admin@housing.com
ADMIN_PASSWORD=Admin@12345
